HOST=127.0.0.1
PORT=5173
DATABASE_PATH=data/bookings.sqlite
# Exact IPs of reverse proxies that append the real peer to X-Forwarded-For.
# Empty trusts none. No hostnames, wildcards or CIDRs. Example: 127.0.0.1,::1
TRUSTED_PROXIES=
# Set true when the admin panel is served over HTTPS (including a TLS proxy).
# Leave false for the default loopback HTTP setup. Forwarded protocol is ignored.
ADMIN_COOKIE_SECURE=false
# Optional: server-side notifications. Never use VITE_ prefix for secrets.
# With both values set, delivery is queued atomically in SQLite and retried
# after failures/restarts. At-least-once delivery may repeat a booking ID.
# With either value empty, new bookings are saved without Telegram delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
